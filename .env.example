# Configurações BigQuery; diagnóstico e conferência pública do template não usam .env.
# Autenticar localmente com Application Default Credentials (ADC).
# Não colocar chaves ou tokens neste arquivo.
# Alternativa: caminho para JSON local em credentials/, sem copiar a chave para o .env.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=demarco_absenteismo
BIGQUERY_LOCATION=US
BIGQUERY_MAX_BYTES_BILLED=1073741824
MANAGEMENT_SPREADSHEET_ID=
MANAGEMENT_WORKSHEET=
